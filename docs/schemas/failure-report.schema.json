{
  "$id": "https://heimdall.lk/schemas/v1/failure-report",
  "title": "Failure Report Payload",
  "description": "Payload for payload_type='failure'. A failed measurement is still a result (FR13) and must be reported. Carried inside a signing envelope. Transport failures are spooled and sent once the connection returns.",
  "type": "object",
  "required": ["v", "failure_id", "failure_type", "started_at", "failed_at", "error_code", "detail", "context"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Protocol version. Must be 1."
    },
    "failure_id": {
      "type": "string",
      "description": "ULID generated by the agent at failure detection. Globally unique.",
      "minLength": 26,
      "maxLength": 26
    },
    "failure_type": {
      "type": "string",
      "enum": [
        "measurement_timeout",
        "probe_unreachable",
        "lease_denied",
        "transport_failure",
        "chain_break",
        "spool_corrupt"
      ],
      "description": "Category of failure."
    },
    "started_at": {
      "type": "integer",
      "description": "Unix timestamp when the operation that failed began.",
      "minimum": 0
    },
    "failed_at": {
      "type": "integer",
      "description": "Unix timestamp when the failure was detected.",
      "minimum": 0
    },
    "error_code": {
      "type": "string",
      "enum": [
        "E_PROBE_TIMEOUT",
        "E_PROBE_UNREACHABLE",
        "E_TLS_PIN_MISMATCH",
        "E_LEASE_OFFICE_BUSY",
        "E_LEASE_CEILING_REACHED",
        "E_LEASE_TOKEN_INVALID",
        "E_LEASE_TOKEN_EXPIRED",
        "E_UNKNOWN"
      ],
      "description": "Machine-readable error code."
    },
    "detail": {
      "type": "string",
      "description": "Free-text description for human review.",
      "maxLength": 512
    },
    "context": {
      "type": "object",
      "description": "Optional additional fields. No field in context may carry a command, URL, or script.",
      "additionalProperties": false,
      "properties": {
        "probe_id": {
          "type": "string",
          "description": "The probe involved, if applicable.",
          "maxLength": 64
        },
        "lease_token": {
          "type": "string",
          "description": "The lease token involved, if applicable.",
          "maxLength": 2048
        }
      }
    }
  }
}
