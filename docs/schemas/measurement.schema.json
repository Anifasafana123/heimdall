{
  "$id": "https://heimdall.lk/schemas/v1/measurement",
  "title": "Measurement Result Payload",
  "description": "Payload for payload_type='measurement'. Reports throughput, latency, jitter, and loss. Carried inside a signing envelope. A failed measurement uses failure.schema.json instead.",
  "type": "object",
  "required": ["v", "measurement_id", "started_at", "duration_ms", "latency", "jitter", "loss", "link_context", "probe_id"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Protocol version. Must be 1."
    },
    "measurement_id": {
      "type": "string",
      "description": "ULID generated by the agent at measurement start. Globally unique.",
      "minLength": 26,
      "maxLength": 26
    },
    "started_at": {
      "type": "integer",
      "description": "Unix timestamp when the measurement began. Advisory; server receive time is authoritative.",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "description": "Total measurement wall time in milliseconds.",
      "minimum": 0
    },
    "throughput": {
      "type": "object",
      "description": "Throughput measurement. Omit entirely for latency-only measurements. When present, lease_token is required.",
      "required": ["download_bps", "upload_bps", "streams", "method"],
      "additionalProperties": false,
      "properties": {
        "download_bps": {
          "type": "integer",
          "description": "Download throughput in bits per second.",
          "minimum": 0
        },
        "upload_bps": {
          "type": "integer",
          "description": "Upload throughput in bits per second.",
          "minimum": 0
        },
        "streams": {
          "type": "integer",
          "description": "Number of parallel TCP streams used.",
          "minimum": 1,
          "maximum": 16
        },
        "method": {
          "type": "string",
          "const": "rmbt",
          "description": "Throughput method. Always 'rmbt' in v1."
        }
      }
    },
    "latency": {
      "type": "object",
      "description": "Latency statistics from the UDP echo probe train.",
      "required": ["min_ms", "max_ms", "mean_ms", "median_ms", "p95_ms"],
      "additionalProperties": false,
      "properties": {
        "min_ms": {
          "type": "integer",
          "description": "Minimum RTT in milliseconds.",
          "minimum": 0
        },
        "max_ms": {
          "type": "integer",
          "description": "Maximum RTT in milliseconds.",
          "minimum": 0
        },
        "mean_ms": {
          "type": "integer",
          "description": "Mean RTT in milliseconds.",
          "minimum": 0
        },
        "median_ms": {
          "type": "integer",
          "description": "Median RTT in milliseconds.",
          "minimum": 0
        },
        "p95_ms": {
          "type": "integer",
          "description": "95th-percentile RTT in milliseconds.",
          "minimum": 0
        }
      }
    },
    "jitter": {
      "type": "object",
      "description": "Inter-packet delay variation.",
      "required": ["mean_ms", "max_ms"],
      "additionalProperties": false,
      "properties": {
        "mean_ms": {
          "type": "integer",
          "description": "Mean inter-packet delay variation in milliseconds.",
          "minimum": 0
        },
        "max_ms": {
          "type": "integer",
          "description": "Maximum inter-packet delay variation in milliseconds.",
          "minimum": 0
        }
      }
    },
    "loss": {
      "type": "object",
      "description": "Packet loss from the UDP echo probe train.",
      "required": ["packets_sent", "packets_received", "loss_percent"],
      "additionalProperties": false,
      "properties": {
        "packets_sent": {
          "type": "integer",
          "description": "Number of UDP echo packets sent.",
          "minimum": 1
        },
        "packets_received": {
          "type": "integer",
          "description": "Number of UDP echo packets received.",
          "minimum": 0
        },
        "loss_percent": {
          "type": "number",
          "description": "Packet loss as a percentage.",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "link_context": {
      "type": "object",
      "description": "Network interface context at the time of measurement.",
      "required": ["interface_type", "mtu"],
      "additionalProperties": false,
      "properties": {
        "interface_type": {
          "type": "string",
          "enum": ["ethernet", "wifi", "cellular", "loopback", "other"],
          "description": "Type of network interface used."
        },
        "link_speed_bps": {
          "type": ["integer", "null"],
          "description": "Negotiated link speed in bits per second. Null if unknown.",
          "minimum": 0
        },
        "mtu": {
          "type": "integer",
          "description": "Interface MTU in bytes.",
          "minimum": 576,
          "maximum": 9000
        },
        "dns_resolver_class": {
          "type": "string",
          "enum": ["isp", "public", "private", "unknown"],
          "description": "Classification of the DNS resolver in use."
        },
        "asn": {
          "type": ["integer", "null"],
          "description": "Autonomous system number of the public IP. Null if unknown.",
          "minimum": 1
        }
      }
    },
    "probe_id": {
      "type": "string",
      "description": "Identifier of the HEIMDALL probe node used.",
      "minLength": 1,
      "maxLength": 64
    },
    "lease_token": {
      "type": "string",
      "description": "Speedtest lease token from the lease response. Required when throughput is present.",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "if": {
    "required": ["throughput"]
  },
  "then": {
    "required": ["lease_token"]
  }
}
