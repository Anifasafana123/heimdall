{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, computer_id, office_id, payload_type,\n            recorded_at,\n            latency_min_ms, latency_max_ms, latency_mean_ms,\n            latency_median_ms, latency_p95_ms,\n            jitter_mean_ms, jitter_max_ms,\n            loss_percent,\n            download_bps, upload_bps,\n            interface_type, asn,\n            quality\n        FROM metrics\n        WHERE computer_id  = $1\n          AND payload_type = $2\n          AND quality      = 'ok'\n        ORDER BY recorded_at DESC\n        LIMIT 1\n        ",
